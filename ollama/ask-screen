#!/usr/bin/env bash
set -Eeuo pipefail

MODEL="gemma4-e4b-uncensored"
IMAGE="$(mktemp --suffix=.png)"
trap 'rm -f "$IMAGE"' EXIT

flameshot gui --raw --accept-on-select >"$IMAGE"

if [[ ! -s "$IMAGE" ]] || ! file "$IMAGE" | grep -q 'PNG image data'; then
  echo "No Screenshot Provided." >&2
  exit 1
fi

gnome-terminal -- ollama serve &&
  sleep 7

ollama run "$MODEL" \
  "Что изображено на этом скриншоте? $IMAGE"
